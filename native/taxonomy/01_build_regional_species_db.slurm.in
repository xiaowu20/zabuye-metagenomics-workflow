#!/usr/bin/env bash
#SBATCH --job-name=regional_k2db
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=60
#SBATCH --mem=460G
#SBATCH --time=72:00:00
#SBATCH --output=@PROJECT@/dual_species_reanalysis_20260819/logs/build_%j.out
#SBATCH --error=@PROJECT@/dual_species_reanalysis_20260819/logs/build_%j.err

set -euo pipefail
source @CONDA@/etc/profile.d/conda.sh
conda activate assembly

RUN_ROOT=@PROJECT@/dual_species_reanalysis_20260819
DB=${RUN_ROOT}/db/regional_species
MAP=${RUN_ROOT}/data/regional_reference_map.tsv
TAXONOMY=${RUN_ROOT}/taxonomy
LIB=${DB}/library/regional/regional_operational_species.fna
PRELIM=${DB}/library/regional/prelim_map.txt
THREADS=${SLURM_CPUS_PER_TASK}
if [[ -z "${KRAKEN_LIBEXEC:-}" ]]; then
  candidates=("$CONDA_PREFIX"/share/kraken2-*/libexec)
  [[ ${#candidates[@]} -eq 1 && -d "${candidates[0]}" ]] || { echo "Set KRAKEN_LIBEXEC to the installed Kraken2 libexec directory" >&2; exit 1; }
  KRAKEN_LIBEXEC=${candidates[0]}
fi
export KRAKEN2_DIR="${KRAKEN_LIBEXEC}"
export KRAKEN2_PROTEIN_DB=""

mkdir -p "${RUN_ROOT}/logs" "${RUN_ROOT}/versions" "${DB}/taxonomy" "$(dirname "${LIB}")"
cp "${TAXONOMY}/nodes.dmp" "${DB}/taxonomy/nodes.dmp"
cp "${TAXONOMY}/names.dmp" "${DB}/taxonomy/names.dmp"

{
  date -Is
  hostname
  kraken2 --version | head -1
  bracken -v 2>&1 | head -1
  bracken-build -v 2>&1 | head -1
  python --version
} > "${RUN_ROOT}/versions/database_build_versions.txt"

if [[ ! -s "${LIB}" ]]; then
  python "${RUN_ROOT}/code/01_make_labeled_library.py" \
    --mapping "${MAP}" \
    --output "${LIB}" \
    --missing "${RUN_ROOT}/logs/missing_reference_fastas.txt" \
    | tee "${RUN_ROOT}/logs/labeled_library_summary.txt"
else
  echo "Reusing completed labelled library: ${LIB}"
fi

# Match Kraken2's standard --add-to-library preprocessing. The labelled
# library is masked in place to avoid a second 87.5-Gb copy; the .masked
# sentinel is created by the Kraken2 helper after successful completion.
if [[ ! -e "${LIB}.masked" ]]; then
  MASK_TMP="${LIB}.masking.tmp"
  MASK_DIR="${DB}/mask_parts"
  rm -f "${MASK_TMP}"
  if command -v k2mask >/dev/null 2>&1; then
    k2mask -in "${LIB}" -outfmt fasta | sed -e '/^>/!s/[a-z]/x/g' > "${MASK_TMP}"
  else
    # This Kraken2 package omits k2mask but ships NCBI dustmasker in the
    # active assembly environment. Split only at FASTA record boundaries,
    # mask the parts in parallel, and convert soft masking to the same
    # x-masked representation expected by Kraken2.
    rm -rf "${MASK_DIR}"
    seqkit split2 --by-part "${THREADS}" --threads "${THREADS}" --force \
      --out-dir "${MASK_DIR}" "${LIB}"
    mask_part() {
      local part="$1"
      dustmasker -in "${part}" -outfmt fasta | sed -e '/^>/!s/[a-z]/x/g' > "${part}.masked"
    }
    export -f mask_part
    find "${MASK_DIR}" -maxdepth 1 -type f -name '*.fna' -print0 | sort -z | \
      parallel -0 --jobs "${THREADS}" --halt soon,fail=1 mask_part {}
    for part in "${MASK_DIR}"/*.fna.masked; do
      cat "${part}" >> "${MASK_TMP}"
    done
    rm -rf "${MASK_DIR}"
  fi
  mv "${MASK_TMP}" "${LIB}"
  touch "${LIB}.masked"
fi
test -s "${LIB}"
test -e "${LIB}.masked"

# kraken2-build expects a preliminary sequence-to-taxid map generated by the
# same scanner used by --add-to-library. Creating it in place avoids a second
# 87.5-Gb copy of the already labelled FASTA.
"${KRAKEN_LIBEXEC}/scan_fasta_file.pl" "${LIB}" > "${PRELIM}"
test -s "${PRELIM}"

sha256sum "${MAP}" "${DB}/taxonomy/nodes.dmp" "${DB}/taxonomy/names.dmp" \
  > "${RUN_ROOT}/versions/database_input_sha256.txt"

kraken2-build --build --db "${DB}" --threads "${THREADS}"
bracken-build -d "${DB}" -t "${THREADS}" -k 35 -l 150

test -s "${DB}/hash.k2d"
test -s "${DB}/opts.k2d"
test -s "${DB}/taxo.k2d"
test -s "${DB}/database150mers.kmer_distrib"
sha256sum "${DB}"/*.k2d "${DB}/database150mers.kmer_distrib" \
  > "${RUN_ROOT}/versions/regional_database_sha256.txt"
date -Is
