#!/usr/bin/env python3
import os, sys, glob, argparse

def fasta_to_s2b(bin_dir, ext, output):
    with open(output, 'w') as out:
        for fa in glob.glob(os.path.join(bin_dir, f'*.{ext}')):
            bin_name = os.path.splitext(os.path.basename(fa))[0]
            with open(fa) as f:
                for line in f:
                    if line.startswith('>'):
                        # 只取第一个字段，去掉深度等额外信息
                        contig = line.strip().lstrip('>').split()[0]
                        out.write(f'{contig}\t{bin_name}\n')

if __name__ == '__main__':
    p = argparse.ArgumentParser()
    p.add_argument('-i', required=True)
    p.add_argument('-e', required=True)
    p.add_argument('-o', required=True)
    args = p.parse_args()
    fasta_to_s2b(args.i, args.e, args.o)
    count = sum(1 for _ in open(args.o))
    print(f'完成: {args.o}, {count}行')
