#!/bin/bash
#SBATCH --job-name=FM_R1_CONCOCT
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --mem=192G
#SBATCH --time=2-00:00:00
#SBATCH --array=0-3%4
#SBATCH --output=@REVISION@/logs/concoct_%A_%a.out
#SBATCH --error=@REVISION@/logs/concoct_%A_%a.err
set -euo pipefail
BASE=@PROJECT@
ROOT="$BASE/Major_revised_FM/R1_20261110"
export PATH=@CONDA@/envs/binning/bin:$PATH
export PYTHONPATH="$ROOT/envs/concoct_compat${PYTHONPATH:+:$PYTHONPATH}"
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
groups=(ZBY_water ZBY_sed DXC_water DXC_sed)
group=${groups[$SLURM_ARRAY_TASK_ID]}
OUT="$ROOT/binning/original_$group"
mkdir -p "$OUT/concoct_bins" "$OUT/dastool3"
contigs="$BASE/05_assembly/$group/$group.contigs.fa"
concoct --version > "$OUT/version.txt" 2>&1
cut_up_fasta.py "$contigs" -c 10000 -o 0 --merge_last -b "$OUT/contigs_10K.bed" > "$OUT/contigs_10K.fa"
concoct_coverage_table.py "$OUT/contigs_10K.bed" "$BASE/06_bins/$group/bam/"*.sorted.bam > "$OUT/coverage.tsv"
concoct --composition_file "$OUT/contigs_10K.fa" --coverage_file "$OUT/coverage.tsv" -b "$OUT/concoct/" -t 32 -l 1500 --seed 20261110
merge_cutup_clustering.py "$OUT/concoct/clustering_gt1500.csv" > "$OUT/concoct/clustering_merged.csv"
extract_fasta_bins.py "$contigs" "$OUT/concoct/clustering_merged.csv" --output_path "$OUT/concoct_bins"
python "$BASE/scripts/fasta_to_s2b.py" -i "$BASE/06_bins/$group/metabat2" -e fa -o "$OUT/metabat2_s2b.tsv"
python "$BASE/scripts/fasta_to_s2b.py" -i "$BASE/06_bins/$group/maxbin2" -e fasta -o "$OUT/maxbin2_s2b.tsv"
python "$BASE/scripts/fasta_to_s2b.py" -i "$OUT/concoct_bins" -e fa -o "$OUT/concoct_s2b.tsv"
DAS_Tool -i "$OUT/metabat2_s2b.tsv,$OUT/maxbin2_s2b.tsv,$OUT/concoct_s2b.tsv" -l metabat2,maxbin2,concoct -c "$contigs" -o "$OUT/dastool3/refined" -t 32 --score_threshold 0.5 --write_bins --write_bin_evals
export PATH=@CONDA@/envs/checkm2/bin:$PATH
checkm2 predict --input "$OUT/dastool3/refined_DASTool_bins" --output-directory "$OUT/checkm2" --extension fa --threads 32 --database_path "$BASE/db/checkm2/CheckM2_database/uniref100.KO.1.dmnd"
date --iso-8601=seconds > "$OUT/COMPLETE.txt"
