#!/bin/bash
#SBATCH --job-name=FM_R1_ar53
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --mem=96G
#SBATCH --time=2-00:00:00
#SBATCH --output=@REVISION@/logs/ar53_%j.out
#SBATCH --error=@REVISION@/logs/ar53_%j.err
set -euo pipefail
BASE=@PROJECT@
ROOT="$BASE/Major_revised_FM/R1_20261110"
export PATH=@CONDA@/envs/gtdbtk_v25/bin:$PATH
export GTDBTK_DATA_PATH="$BASE/db/gtdbtk_r226"
mkdir -p "$ROOT/phylogeny/genomes84" "$ROOT/phylogeny/aa84"
while read -r mag; do
  test -s "$BASE/09_drep/dereplicated_genomes/$mag.fa"
  ln -snf "$BASE/09_drep/dereplicated_genomes/$mag.fa" "$ROOT/phylogeny/genomes84/$mag.fa"
done < "$ROOT/inputs/halo84_ids.txt"
gtdbtk --version > "$ROOT/provenance/phylogeny_gtdbtk_version.txt" 2>&1
gtdbtk identify --genome_dir "$ROOT/phylogeny/genomes84" -x fa --out_dir "$ROOT/phylogeny/gtdb84" --cpus 32 --write_single_copy_genes --debug
gtdbtk align --identify_dir "$ROOT/phylogeny/gtdb84" --out_dir "$ROOT/phylogeny/gtdb84" --skip_gtdb_refs --cpus 32 --debug
gzip -cd "$ROOT/phylogeny/gtdb84/align/gtdbtk.ar53.user_msa.fasta.gz" > "$ROOT/phylogeny/aa84/ar53_masked.faa"
@CONDA@/envs/iqtree/bin/iqtree -s "$ROOT/phylogeny/aa84/ar53_masked.faa" -m MFP -B 1000 --alrt 1000 -T 32 --seed 20261110 --prefix "$ROOT/phylogeny/aa84/ar53_BIC"
